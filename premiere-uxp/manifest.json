{
  "id": "lk.poruwacut.panel",
  "name": "AutoWed",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:7788",
        "http://localhost:7788"
      ]
    },
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "id": "poruwacut-main",
      "type": "panel",
      "label": {
        "default": "AutoWed"
      },
      "minimumSize": {
        "width": 280,
        "height": 420
      },
      "maximumSize": {
        "width": 1200,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 360,
        "height": 680
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "all"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.svg",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}